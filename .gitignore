# Планировочные документы агента — вне репозитория
/логи/

# Конфигурация agentic-инструментов — вне репозитория
AGENTS.md
opencode.json
.claude/
CLAUDE.md
.cursor/
.cursorrules
.github/copilot-instructions.md

# Go
/bin/
/coverage/
*.exe
*.exe~
*.test
# *.test — Go-тестовый бинарь; негатив — тестовый OCI-образ (не бинарник)
!deploy/Containerfile.test
*.out
*.prof

# Данные времени выполнения
/data/

# Сырые результаты нагрузочных прогонов bench/: CSV сэмплеров, снапшоты
# /metrics, k6 summary-export. Эталонные цифры — таблицами в
# docs/func/ru/benchmarks.md, сырьё не версионируется.
/bench/results/
# Список холодных объектов генерируется под конкретный прогон (какие
# пути не в кеше на момент запуска) — текучий, в git не замораживаем.
/bench/k6/urls-cold.txt

# Web
web/node_modules/
web/dist/
# Собранный SPA-бандл встраивается через //go:embed; источником служит
# web/ (npm run build). Не коммитится: vite с emptyOutDir стирает папку,
# а заглушку для сборки без фронтенда восстанавливает `make clean`/`make
# web-stub` (зависимость lint/test/build). По образцу lentovodec.
internal/core/web/assets/

# Секреты и локальное окружение
.env
.env.*
*.local.toml

# Корень step-ca в контекст сборки образа: builder сам скачивает его с
# CA-сервера (шаг в build.yml / цель в Makefile) непосредственно перед
# podman build — в git не замораживаем, чтобы всегда был свежий.
deploy/certs/step-ca-root.pem
