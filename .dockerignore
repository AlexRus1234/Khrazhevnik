# Планировочные документы агента (вне репозитория, но на всякий случай)
/логи/

# Артефакты сборки Go
/bin/
/coverage/
*.exe
*.exe~
*.test
*.out
*.prof

# Web: node-зависимости и локальные сборки SPA. internal/core/web/assets/
# тоже исключён: в git его нет (.gitignore, сессия 18.1), а Containerfile
# собирает бандл заново в web-stage (FROM node:22-alpine AS web) и кладёт в
# build-stage через COPY --from=web для //go:embed. Локальные артефакты
# (make web-build) в образ не протекают — сборка воспроизводима.
web/node_modules/
web/dist/
internal/core/web/assets/

# Данные времени выполнения (контейнер пишет в /var/lib/khrazhevnik)
/data/

# Секреты и локальное окружение
.env
.env.*
*.local.toml

# Редактор/IDE/OS
.vscode/
.idea/
*.swp
.DS_Store
