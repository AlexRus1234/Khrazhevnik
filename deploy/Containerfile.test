# Хражевник — тестовый OCI-образ для CI (distro-test).
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Отличие от deploy/Containerfile — только финальная стадия: вместо
# scratch — alpine с curl/jq/sqlite3. Релизный образ не содержит ни
# shell, ни curl (FROM scratch), поэтому `podman exec` для healthz,
# bootstrap admin-API изнутри и отладки каталога против него невозможен.
# Тестовый образ в прод не публикуется: прод = deploy/Containerfile.
#
# Внутри — ТОТ ЖЕ бинарь (те же стадии web/build), что и в релизном.
# Окружение — дефолты (sqlite + fs); в контейнер передаётся только
# KHRZ_AUTH__JWT_SECRET. Сборка — make image-test.

# web: Vue-SPA (vue-tsc + vite build). vite.config.ts задаёт
# outDir '../internal/core/web/assets' — при WORKDIR=/web resolves в
# /internal/core/web/assets (тот же конфиг, что локально; без переопределения
# через CLI, к-рое npm не пробрасывает сквозь script с &&). package*.json
# отдельным слоем — кеш npm между правками исходников Vue. web/node_modules
# в контекст не попадает (.gitignore в чистом checkout) — COPY web/ не затирает
# результат npm ci.
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.26-alpine AS build
# ca-certificates: scratch-образу нужен бандл доверенных CA, иначе
# HTTPS-запросы к upstream-зеркалам упадут с x509. git — фолбэк версии
# через git describe при локальной сборке без --build-arg VERSION.
RUN apk add --no-cache ca-certificates git
ARG VERSION=
WORKDIR /src
COPY . .
# Встроенный SPA-бандл из web-stage: //go:embed (internal/core/web/spa.go)
# требует assets/index.html на момент go build. В build-context (git checkout)
# assets/ не лежит (gitignore) — берём собранный бандл из web-stage.
COPY --from=web /internal/core/web/assets ./internal/core/web/assets
# -X main.Version: линкер Go 1.26 для package main принимает только
# "main.Version", не полный importpath (полный путь молча не apply'ится;
# проверено локально, см. .forgejo/workflows/build.yml).
RUN set -e; \
    v="${VERSION}"; \
    if [ -z "$v" ]; then v="$(git describe --tags --always 2>/dev/null || echo dev)"; fi; \
    CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.Version=$v" \
        -o /out/khrazhevnik ./cmd/khrazhevnik

# curl — exec-healthz и ожидание старта; jq — bootstrap admin-API изнутри;
# openssl — генерация секрета/клиентских проверок; sqlite — отладка каталога.
# Пакет sqlite, не sqlite3: alpine 3.24 (плавающий alpine:3, CI-факт
# 2026-09-06) слил CLI-подпакет в sqlite — «sqlite3 (no such package)».
FROM alpine:3
RUN apk add --no-cache ca-certificates curl jq openssl sqlite
COPY --from=build /out/khrazhevnik /khrazhevnik
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
USER 65534:65534
EXPOSE 29202 30202
VOLUME ["/var/lib/khrazhevnik"]
ENTRYPOINT ["/khrazhevnik"]
